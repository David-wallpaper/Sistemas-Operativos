GCC= gcc
FLAGS= -lm -lpthread

PROGRAMAS= pthread01, pthread02, productorConsumidor

pthread01:
	$(GCC) $(FLAGS) $@.c -o $@


pthread02:
	$(GCC) $(FLAGS) $@.c -o $@

productorConsumidor:
	$(GCC) $(FLAGS) $@.c -o $@

clear:
	$(GCC) $(PROGRAMAS)