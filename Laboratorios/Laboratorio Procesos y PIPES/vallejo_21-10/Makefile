	$(GCC) $@.c -o $@


fork03:
	$(GCC) $@.c -o $@

fork04:

	$(GCC) $@.c -o $@

fork05:
	$(GCC) $@.c -o $@

fork06:
	$(GCC) $@.c -o $@

